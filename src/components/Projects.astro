---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import ProjectCard from './ProjectCard.astro';
import ProjectDialog from './ProjectDialog.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const filters = ['Todos', 'UI/UX', 'Editorial', 'Brand Identity', 'Digital Design', 'Social Media'];

// Datos para el diálogo: las imágenes se optimizan aquí (WebP) y se pasan como URL al script.
const dialogData = Object.fromEntries(
  await Promise.all(
    projects.map(async (p) => {
      const { cover, banner, icon, gallery, ...rest } = p.data;
      const bannerImg = banner ? await getImage({ src: banner, width: 1400, format: 'webp', quality: 85 }) : undefined;
      const shots = await Promise.all(
        gallery.map(async (g) => {
          const img = await getImage({ src: g.src, width: g.src.width / g.src.height > 0.8 ? 760 : 420, format: 'webp', quality: 85 });
          return { src: img.src, w: img.attributes.width, h: img.attributes.height, alt: g.alt };
        }),
      );
      return [
        p.id,
        {
          ...rest,
          hasMockups: Boolean(p.data.mockups) && shots.length === 0,
          banner: bannerImg && { src: bannerImg.src, w: bannerImg.attributes.width, h: bannerImg.attributes.height },
          gallery: shots,
        },
      ];
    }),
  ),
);
---

<section class="section" id="proyectos" aria-labelledby="projects-title">
  <div class="container">
    <div class="section-head">
      <p class="label">Proyectos</p>
      <h2 class="h-section" id="projects-title">Trabajo seleccionado</h2>
    </div>

    <div class="filters" role="group" aria-label="Filtrar proyectos por categoría">
      {
        filters.map((f, i) => (
          <button type="button" class="chip" data-filter={f} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f}
          </button>
        ))
      }
    </div>
    <p class="sr-only" role="status" data-count></p>

    <ul class="grid" data-grid>
      {projects.map((p) => <ProjectCard id={p.id} project={p.data} />)}
    </ul>
  </div>

  <ProjectDialog />
  <script type="application/json" id="projects-data" set:html={JSON.stringify(dialogData)} />
</section>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: clamp(24px, 4vw, 40px);
  }

  .chip {
    min-height: 44px;
    padding: 0 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--fg);
    font-size: 14px;
    font-weight: 500;
    transition: border-color 0.2s, background-color 0.2s;
  }

  .chip[aria-pressed='true'] {
    background: var(--lime);
    border-color: var(--lime);
    color: var(--lime-ink);
  }

  @media (hover: hover) {
    .chip[aria-pressed='false']:hover {
      border-color: var(--lime);
    }
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap);
  }

  .grid > :global([hidden]) {
    display: none;
  }

  @media (min-width: 760px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

<script>
  type Project = {
    title: string;
    category: string;
    client: string;
    year?: string;
    hook: string;
    problem: string;
    solution: string;
    tools: string[];
    highlight?: string;
    accent: string;
    hasMockups: boolean;
    banner?: { src: string; w: number; h: number };
    gallery: { src: string; w: number; h: number; alt: string }[];
    mockupCount?: number;
    mockupNote?: string;
    pending?: string;
  };

  const data: Record<string, Project> = JSON.parse(document.getElementById('projects-data')?.textContent ?? '{}');

  // ---- Filtros ----
  const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-filter]'));
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-grid] > [data-category]'));
  const count = document.querySelector<HTMLElement>('[data-count]');

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const f = chip.dataset.filter;
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      let shown = 0;
      cards.forEach((card) => {
        const show = f === 'Todos' || card.dataset.category === f;
        card.hidden = !show;
        if (show) shown++;
      });
      if (count) count.textContent = `${shown} ${shown === 1 ? 'proyecto' : 'proyectos'}`;
    }),
  );

  // ---- Diálogo ----
  const dlg = document.querySelector<HTMLDialogElement>('[data-dialog]');
  if (dlg) {
    const f = (name: string) => dlg.querySelector<HTMLElement>(`[data-f="${name}"]`)!;
    const text = (name: string, value?: string) => {
      const el = f(name);
      el.textContent = value ?? '';
      el.hidden = !value;
    };

    const fill = (p: Project) => {
      f('strip').style.setProperty('--accent', p.accent);
      dlg.style.setProperty('--accent', p.accent);
      text('category', p.category);
      text('year', p.year);
      text('title', p.title);
      text('client', p.client);
      text('hook', p.hook);
      text('highlight', p.highlight);
      text('problem', p.problem);
      text('solution', p.solution);
      text('pending', p.pending ? `[PENDIENTE: ${p.pending}]` : undefined);

      const tools = f('tools');
      tools.replaceChildren(
        ...p.tools.map((t) => {
          const li = document.createElement('li');
          li.className = 'pill';
          li.textContent = t;
          return li;
        }),
      );
      f('tools-wrap').hidden = p.tools.length === 0;

      const bn = f('banner') as HTMLElement;
      bn.replaceChildren();
      bn.hidden = !p.banner;
      if (p.banner) {
        const im = new Image();
        im.src = p.banner.src;
        im.width = p.banner.w;
        im.height = p.banner.h;
        im.alt = 'Composición de pantallas de ' + p.title;
        im.decoding = 'async';
        bn.append(im);
      }

      const gl = f('gallery');
      gl.replaceChildren();
      f('gallery-wrap').hidden = p.gallery.length === 0;
      p.gallery.forEach((g) => {
        const li = document.createElement('li');
        const im = new Image();
        im.src = g.src;
        im.width = g.w;
        im.height = g.h;
        im.alt = g.alt;
        im.loading = 'lazy';
        im.decoding = 'async';
        li.append(im);
        gl.append(li);
      });
      // Copia de la lista para el bucle continuo (oculta a lectores de pantalla)
      if (p.gallery.length > 1) {
        Array.from(gl.children).forEach((n) => {
          const c = n.cloneNode(true) as HTMLElement;
          c.setAttribute('aria-hidden', 'true');
          c.querySelector('img')?.setAttribute('alt', '');
          gl.append(c);
        });
      }

      const mock = f('mock');
      mock.replaceChildren();
      f('mock-wrap').hidden = !p.hasMockups;
      if (p.hasMockups) {
        for (let i = 0; i < (p.mockupCount ?? 0); i++) {
          const fr = document.createElement('span');
          fr.className = 'frame';
          mock.append(fr);
        }
        const t = document.createElement('p');
        t.className = 'mock-text';
        const s = document.createElement('strong');
        s.textContent = 'Mockup pendiente';
        t.append(s);
        if (p.mockupNote) {
          const n = document.createElement('span');
          n.textContent = p.mockupNote;
          t.append(n);
        }
        mock.append(t);
      }
    };

    // ---- Galería: avanza sola de derecha a izquierda, se detiene con el cursor y se arrastra ----
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const SPEED = 38; // px por segundo
    let raf = 0;
    let off: (() => void) | undefined;

    function stopGallery() {
      cancelAnimationFrame(raf);
      off?.();
      off = undefined;
    }

    function startGallery() {
      stopGallery();
      const el = f('gallery');
      if (el.hidden || f('gallery-wrap').hidden || el.children.length < 2) return;
      const looping = el.children.length > 0 && el.querySelector('[aria-hidden]') !== null;
      const half = () => {
        const n = el.children.length / 2;
        return (el.children[n] as HTMLElement).offsetLeft - (el.children[0] as HTMLElement).offsetLeft;
      };

      let pos = 0;
      let hover = false;
      let drag = false;
      let touch = 0;
      let startX = 0;
      let startPos = 0;
      let last = 0;
      el.scrollLeft = 0;

      const wrap = () => {
        if (!looping) return;
        const h = half();
        if (h <= 0) return;
        while (pos >= h) {
          pos -= h;
          startPos -= h;
        }
        while (pos < 0) {
          pos += h;
          startPos += h;
        }
      };

      const tick = (t: number) => {
        const dt = Math.min(0.05, (t - (last || t)) / 1000);
        last = t;
        if (!drag && !hover && !touch && !reduce && !el.matches(':focus-visible')) pos += SPEED * dt;
        wrap();
        el.scrollLeft = pos;
        raf = requestAnimationFrame(tick);
      };

      const onEnter = (e: PointerEvent) => {
        if (e.pointerType === 'mouse') hover = true;
      };
      const onLeave = (e: PointerEvent) => {
        if (e.pointerType === 'mouse') hover = false;
      };
      const onDown = (e: PointerEvent) => {
        if (e.pointerType !== 'mouse' || e.button !== 0) return;
        drag = true;
        startX = e.clientX;
        startPos = pos;
        el.classList.add('dragging');
        el.setPointerCapture(e.pointerId);
      };
      const onMove = (e: PointerEvent) => {
        if (!drag) return;
        pos = startPos - (e.clientX - startX);
        wrap();
      };
      const onUp = (e: PointerEvent) => {
        if (!drag) return;
        drag = false;
        el.classList.remove('dragging');
        if (el.hasPointerCapture(e.pointerId)) el.releasePointerCapture(e.pointerId);
      };
      // Dedo o trackpad: el desplazamiento nativo manda; se pausa y se sincroniza la posición
      const onScroll = () => {
        if (!drag && Math.abs(el.scrollLeft - pos) > 1.5) {
          pos = el.scrollLeft;
          wrap();
        }
      };
      const onTouch = () => {
        clearTimeout(touch);
        touch = window.setTimeout(() => (touch = 0), 2500) as unknown as number;
        touch = touch || 1;
      };
      const onWheel = (e: WheelEvent) => {
        if (Math.abs(e.deltaX) > Math.abs(e.deltaY)) {
          pos += e.deltaX;
          wrap();
          e.preventDefault();
        }
      };

      el.addEventListener('pointerenter', onEnter);
      el.addEventListener('pointerleave', onLeave);
      el.addEventListener('pointerdown', onDown);
      el.addEventListener('pointermove', onMove);
      el.addEventListener('pointerup', onUp);
      el.addEventListener('pointercancel', onUp);
      el.addEventListener('scroll', onScroll, { passive: true });
      el.addEventListener('touchstart', onTouch, { passive: true });
      el.addEventListener('touchmove', onTouch, { passive: true });
      el.addEventListener('wheel', onWheel, { passive: false });
      off = () => {
        el.removeEventListener('pointerenter', onEnter);
        el.removeEventListener('pointerleave', onLeave);
        el.removeEventListener('pointerdown', onDown);
        el.removeEventListener('pointermove', onMove);
        el.removeEventListener('pointerup', onUp);
        el.removeEventListener('pointercancel', onUp);
        el.removeEventListener('scroll', onScroll);
        el.removeEventListener('touchstart', onTouch);
        el.removeEventListener('touchmove', onTouch);
        el.removeEventListener('wheel', onWheel);
        el.classList.remove('dragging');
      };
      raf = requestAnimationFrame(tick);
    }

    document.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-open]');
      if (btn) {
        const p = data[btn.dataset.open ?? ''];
        if (!p) return;
        fill(p);
        dlg.scrollTop = 0;
        dlg.showModal();
        startGallery();
        dlg.querySelector<HTMLElement>('[data-close]')?.focus();
        return;
      }
    });

    dlg.addEventListener('close', stopGallery);

    dlg.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (t === dlg || t.closest('[data-close]')) dlg.close();
    });
  }
</script>
