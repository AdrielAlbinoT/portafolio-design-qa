---
const links = [
  { href: '#sobre-mi', label: 'Sobre mí' },
  { href: '#experiencia', label: 'Experiencia' },
  { href: '#qa', label: 'QA' },
  { href: '#proyectos', label: 'Proyectos' },
  { href: '#contacto', label: 'Contacto' },
];
---

<footer class="footer">
  <div class="container bottom">
    <p class="copy">© 2026 Adriel Albino Tasayco. Todos los derechos reservados.</p>
    <nav aria-label="Pie de página">
      <ul class="flinks">
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="up btn btn--ghost btn--small" href="#inicio">Volver arriba ↑</a>
  </div>
</footer>

<style>
  .footer {
    background: var(--surface);
    border-top: 1px solid var(--line);
  }

  .bottom {
    display: grid;
    gap: 16px;
    justify-items: start;
    padding-block: 24px calc(24px + env(safe-area-inset-bottom, 0px));
  }

  .copy {
    font-size: 13px;
    color: var(--muted);
  }

  .flinks {
    display: flex;
    flex-wrap: wrap;
    gap: 0 4px;
  }

  .flinks a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 10px 0 0;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }

  .flinks a:hover {
    color: var(--lime);
  }

  @media (min-width: 1024px) {
    .bottom {
      grid-template-columns: 1fr auto auto;
      align-items: center;
      gap: 32px;
    }
  }
</style>
