---
import HeroImage from './HeroImage.astro';

const tags = ['Graphic Design', 'UI/UX', 'QA Testing', 'Branding', 'Social Media'];

---

<section class="hero" id="inicio" aria-labelledby="hero-title">
  <div class="container grid-12">
    <div class="text">
      <ul class="tags" aria-label="Servicios">
        {tags.map((t) => <li>{t}</li>)}
      </ul>
      <h1 id="hero-title">Portafolio<br />Creativo</h1>
      <p class="desc">
        Diseño experiencias digitales claras y probadas, donde la usabilidad y la estética conectan con las personas.
      </p>
      <div class="actions">
        <a class="btn btn--lime" href="#proyectos">Ver proyectos</a>
        <a class="btn btn--ghost" href="#sobre-mi">Sobre mí</a>
      </div>
    </div>
    <div class="visual">
      <HeroImage />
    </div>
  </div>
</section>

<style>
  .hero {
    display: flex;
    align-items: center;
    min-height: calc(100svh - var(--strip-h));
    padding-top: calc(var(--nav-h) + 16px + clamp(28px, 3vw, 40px));
    padding-bottom: clamp(24px, 4vw, 48px);
    scroll-margin-top: 0;
  }

  .hero .container {
    align-items: center;
    row-gap: clamp(32px, 6vw, 56px);
  }

  .text {
    container-type: inline-size;
    min-width: 0;
  }

  h1 {
    font-size: min(var(--fs-hero), 28cqi);
    line-height: 1;
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 16px;
  }

  .tags li {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    color: var(--fg);
    font-size: 14px;
    font-weight: 600;
    line-height: 1;
    cursor: default;
    user-select: none;
  }

  .desc {
    max-width: 48ch;
    margin-top: 20px;
    font-size: clamp(16px, 1.25vw, 18px);
    color: var(--muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  @media (min-width: 1024px) {
    h1 {
      font-size: min(var(--fs-hero), 28cqi, 15.5svh);
    }
    .text {
      grid-column: 1 / 7;
    }
    .visual {
      grid-column: 7 / 13;
    }
  }
</style>
