---
import { getCollection } from 'astro:content';

const all = (await getCollection('experience')).map((e) => e.data);
const jobs = [...all.filter((j) => j.current), ...all.filter((j) => !j.current).sort((a, b) => a.order - b.order)];

// Camino tipo mapa: cada fila dibuja un tramo que baja del empleo i al i+1 (el más antiguo queda abajo).
// xs = posición horizontal (en %) de cada parada; el último valor es hacia dónde se pierde el camino.
const n = jobs.length;
const xs = [60, 28, 68, 32, 58, 40].slice(0, n + 1);
const alpha = (k: number) => +(0.6 * (1 - k / n)).toFixed(3);
// Etiqueta de cada parada: año de término, para que el recorrido suba ordenado hacia el presente.
const label = (j: (typeof jobs)[number]) => (j.current ? 'Actualidad' : (j.period.match(/\d{4}/g) ?? []).pop() ?? j.period);

// Rutas alternas: líneas finas que salen de la ruta principal y se pierden (caminos que no tomé).
// t = punto de la curva donde se bifurca; side = hacia qué lado; dx / dy = alcance (en unidades del tramo).
const forks = [
  [{ t: 0.3, side: -1, dx: 14, dy: 48 }],
  [{ t: 0.25, side: 1, dx: 13, dy: 42 }, { t: 0.62, side: -1, dx: 15, dy: 45 }],
  [{ t: 0.28, side: -1, dx: 15, dy: 44 }, { t: 0.65, side: 1, dx: 13, dy: 44 }],
  [{ t: 0.22, side: 1, dx: 14, dy: 46 }, { t: 0.55, side: -1, dx: 15, dy: 50 }],
];

const branches = (i: number) => {
  const x0 = xs[i];
  const x1 = xs[i + 1];
  const at = (t: number) => {
    const u = 1 - t;
    return {
      x: u * u * u * x0 + 3 * u * u * t * x0 + 3 * u * t * t * x1 + t * t * t * x1,
      y: 3 * u * t * t * 45 + t * t * t * 100 + 3 * u * u * t * 55,
    };
  };
  const tangent = (t: number) => {
    const u = 1 - t;
    const dx = 3 * u * u * 0 + 6 * u * t * (x1 - x0) + 3 * t * t * 0;
    const dy = 3 * u * u * 55 + 6 * u * t * (45 - 55) + 3 * t * t * (100 - 45);
    const len = Math.hypot(dx, dy) || 1;
    return { x: dx / len, y: dy / len };
  };
  return (forks[i % forks.length] ?? []).map((f, k) => {
    const s = at(f.t);
    const d = tangent(f.t);
    const e = { x: s.x + f.side * f.dx, y: Math.min(s.y + f.dy, 112) };
    const c1 = { x: s.x + d.x * 10, y: s.y + d.y * 10 };
    const c2 = { x: e.x - f.side * 1, y: e.y - 20 };
    const r = (v: number) => +v.toFixed(2);
    return {
      id: `br-${i}-${k}`,
      s,
      e,
      d: `M${r(s.x)} ${r(s.y)}C${r(c1.x)} ${r(c1.y)} ${r(c2.x)} ${r(c2.y)} ${r(e.x)} ${r(e.y)}`,
    };
  });
};
---

<section class="section" id="experiencia" aria-labelledby="exp-title">
  <div class="container">
    <h2 class="title" id="exp-title">
      Experiencia:
      <svg class="mark" viewBox="0 0 340 12" preserveAspectRatio="none" aria-hidden="true">
        <path d="M3 8C60 3 120 10 180 5s110 2 157-3" fill="none" stroke="var(--lime)" stroke-width="5" stroke-linecap="round"></path>
      </svg>
    </h2>

    <ol class="timeline">
      {
        jobs.map((j, i) => (
          <li class:list={['job', { current: j.current }]}>
            <div class="left">
              <span class="node" aria-hidden="true" />
              <div class="head">
                <h3>{j.company}</h3>
                <p class="meta">
                  {j.location} · {j.period}
                </p>
              </div>
              {j.role && <p class="role">{j.role}</p>}
              <ul class="items">
                {j.items.map((it) => (
                  <li>{it}</li>
                ))}
              </ul>
            </div>

            <div class="map" aria-hidden="true">
              <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                <defs>
                  <linearGradient id={`road-${i}`} x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color={i === 0 ? '#C6F432' : '#ffffff'} stop-opacity={alpha(i) + (i === 0 ? 0.25 : 0)} />
                    <stop offset="0.45" stop-color="#ffffff" stop-opacity={(alpha(i) + alpha(i + 1)) / 2} />
                    <stop offset="1" stop-color="#ffffff" stop-opacity={alpha(i + 1)} />
                  </linearGradient>
                  {branches(i).map((b) => (
                    <linearGradient id={b.id} gradientUnits="userSpaceOnUse" x1={b.s.x} y1={b.s.y} x2={b.e.x} y2={b.e.y}>
                      <stop offset="0" stop-color="#ffffff" stop-opacity={Math.max(alpha(i) - 0.1, 0.12)} />
                      <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
                    </linearGradient>
                  ))}
                </defs>
                {branches(i).map((b) => (
                  <path class="branch" d={b.d} stroke={`url(#${b.id})`} />
                ))}
                <path class="body" d={`M${xs[i]} 0C${xs[i]} 55 ${xs[i + 1]} 45 ${xs[i + 1]} 100`} stroke={`url(#road-${i})`} />
                <path class="dash" d={`M${xs[i]} 0C${xs[i]} 55 ${xs[i + 1]} 45 ${xs[i + 1]} 100`} stroke={`url(#road-${i})`} />
              </svg>
              <span class:list={['pin', { current: j.current, flip: xs[i] >= 55 }]} style={`left:${xs[i]}%`}>
                <i></i>
                <b>{label(j)}</b>
              </span>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .title {
    position: relative;
    display: inline-block;
    padding-bottom: 16px;
    font-size: var(--fs-section);
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  .mark {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 12px;
  }

  .timeline {
    margin-top: clamp(28px, 4vw, 48px);
  }

  .job {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .left {
    position: relative;
    padding: 0 0 clamp(28px, 4vw, 44px) 32px;
  }

  /* Línea de tiempo vertical que une los nodos */
  .left::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 14px;
    bottom: -8px;
    width: 1px;
    background: var(--line);
  }

  .job:last-child .left::before {
    background: linear-gradient(var(--line), transparent);
  }

  .node {
    position: absolute;
    left: 0;
    top: 6px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--base);
    border: 2px solid var(--muted);
  }

  .current .node {
    background: var(--lime);
    border-color: var(--lime);
    box-shadow: 0 0 0 5px var(--lime-soft);
    animation: twinkle 3.6s ease-in-out infinite;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 16px;
  }

  h3 {
    font-size: 18px;
    line-height: 1.3;
  }

  .meta {
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }

  .role {
    margin-top: 2px;
    color: var(--lime);
    font-size: 14px;
    font-weight: 600;
  }

  .items {
    display: grid;
    gap: 6px;
    margin-top: 10px;
    font-size: 14px;
    color: var(--muted);
  }

  .items li {
    position: relative;
    padding-left: 16px;
    line-height: 1.5;
  }

  .items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 1px;
    background: var(--lime);
  }

  /* ---- Camino tipo mapa ---- */
  .map {
    display: none;
  }

  @media (min-width: 760px) {
    .job {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      column-gap: clamp(24px, 5vw, 72px);
    }

    .map {
      position: relative;
      display: block;
    }

    .map svg {
      position: absolute;
      left: 0;
      top: 14px;
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    .map path {
      fill: none;
      stroke-linecap: round;
      vector-effect: non-scaling-stroke;
    }

    .map .body {
      stroke-width: 18;
      stroke-opacity: 0.16;
    }

    .map .dash {
      stroke-width: 2.5;
      stroke-dasharray: 1 9;
    }

    .map .branch {
      stroke-width: 1.6;
    }

    .pin {
      position: absolute;
      top: 14px;
      width: 0;
      height: 0;
    }

    .pin i {
      position: absolute;
      left: -7px;
      top: -7px;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--fg);
      box-shadow: 0 0 0 5px rgba(243, 245, 238, 0.14);
    }

    .pin b {
      position: absolute;
      left: 16px;
      top: -11px;
      padding: 3px 10px;
      border: 1px solid var(--line);
      border-radius: var(--radius-pill);
      background: rgba(18, 20, 17, 0.7);
      font-size: 12px;
      font-weight: 600;
      line-height: 1.4;
      white-space: nowrap;
      color: var(--muted);
    }

    .pin.flip b {
      left: auto;
      right: 16px;
    }

    .pin.current i {
      background: var(--lime);
      box-shadow: 0 0 0 5px var(--lime-soft);
      animation: twinkle 3.6s ease-in-out infinite;
    }

    .pin.current b {
      color: var(--lime-ink);
      background: var(--lime);
      border-color: var(--lime);
    }
  }

  /* Titileo lento y suave: "aquí estoy ahora" */
  @keyframes twinkle {
    0%,
    100% {
      opacity: 1;
      box-shadow: 0 0 0 5px rgba(198, 244, 50, 0.16);
    }
    50% {
      opacity: 0.5;
      box-shadow: 0 0 0 9px rgba(198, 244, 50, 0.04);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .current .node,
    .pin.current i {
      animation: none;
    }
  }
</style>
