---
import { getCollection } from 'astro:content';
import streets from '../assets/map/streets.svg';

const all = (await getCollection('experience')).map((e) => e.data);
const jobs = [...all.filter((j) => j.current), ...all.filter((j) => !j.current).sort((a, b) => a.order - b.order)];

// Camino tipo mapa: cada fila dibuja un tramo que baja del empleo i al i+1 (el más antiguo queda abajo).
// xs = posición horizontal (en %) de cada parada; el último valor es hacia dónde se pierde el camino.
const n = jobs.length;
const xs = [60, 28, 68, 32, 58, 40].slice(0, n + 1);
const alpha = (k: number) => +(0.6 * (1 - k / n)).toFixed(3);
// Etiqueta de cada parada: año de término, para que el recorrido suba ordenado hacia el presente.
const label = (j: (typeof jobs)[number]) => (j.current ? 'Actualidad' : (j.period.match(/\d{4}/g) ?? []).pop() ?? j.period);

---

<section class="section" id="experiencia" aria-labelledby="exp-title">
  <div class="container">
    <h2 class="title" id="exp-title">
      Experiencia:
      <svg class="mark" viewBox="0 0 340 12" preserveAspectRatio="none" aria-hidden="true">
        <path d="M3 8C60 3 120 10 180 5s110 2 157-3" fill="none" stroke="var(--lime)" stroke-width="5" stroke-linecap="round"></path>
      </svg>
    </h2>

    <div class="tl-wrap">
      <img class="streets" src={streets.src} alt="" width="800" height="1200" loading="lazy" decoding="async" aria-hidden="true" />
    <ol class="timeline">
      {
        jobs.map((j, i) => (
          <li class:list={['job', { current: j.current }]}>
            <div class="left">
              <span class="node" aria-hidden="true" />
              <div class="head">
                <h3>{j.company}</h3>
                <p class="meta">
                  {j.location} · {j.period}
                </p>
              </div>
              {j.role && <p class="role">{j.role}</p>}
              <ul class="items">
                {j.items.map((it) => (
                  <li>{it}</li>
                ))}
              </ul>
            </div>

            <div class="map" aria-hidden="true">
              <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                <defs>
                  <linearGradient id={`road-${i}`} x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color={i === 0 ? '#C6F432' : '#ffffff'} stop-opacity={alpha(i) + (i === 0 ? 0.25 : 0)} />
                    <stop offset="0.45" stop-color="#ffffff" stop-opacity={(alpha(i) + alpha(i + 1)) / 2} />
                    <stop offset="1" stop-color="#ffffff" stop-opacity={alpha(i + 1)} />
                  </linearGradient>
                </defs>
                <path class="body" d={`M${xs[i]} 0C${xs[i]} 55 ${xs[i + 1]} 45 ${xs[i + 1]} 100`} stroke={`url(#road-${i})`} />
                <path class="dash" d={`M${xs[i]} 0C${xs[i]} 55 ${xs[i + 1]} 45 ${xs[i + 1]} 100`} stroke={`url(#road-${i})`} />
              </svg>
              <span class:list={['pin', { current: j.current, flip: xs[i] >= 55 }]} style={`left:${xs[i]}%`}>
                <i></i>
                <b>{label(j)}</b>
              </span>
            </div>
          </li>
        ))
      }
    </ol>
    </div>
  </div>
</section>

<style>
  .title {
    position: relative;
    display: inline-block;
    padding-bottom: 16px;
    font-size: var(--fs-section);
    letter-spacing: -0.025em;
    text-transform: uppercase;
  }

  .mark {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 12px;
  }

  .tl-wrap {
    position: relative;
    margin-top: clamp(28px, 4vw, 48px);
  }

  .timeline {
    position: relative;
    z-index: 1;
  }

  /* Plano de calles de fondo: líneas blancas muy suaves que se difuminan en los bordes, sin tapar texto. */
  .streets {
    display: none;
  }

  @media (min-width: 760px) and (max-width: 1023px) {
    .tl-wrap .streets {
      width: 44%;
    }
  }

  @media (min-width: 760px) {
    .streets {
      display: block;
      position: absolute;
      z-index: 0;
      top: -48px;
      bottom: -48px;
      right: calc(var(--gutter) * -1);
      width: 52%;
      height: calc(100% + 96px);
      object-fit: cover;
      opacity: 0.34;
      pointer-events: none;
      user-select: none;
      -webkit-mask-image: linear-gradient(to right, transparent, #000 38%, #000 78%, transparent),
        linear-gradient(to bottom, transparent, #000 16%, #000 84%, transparent);
      -webkit-mask-composite: source-in;
      mask-image: linear-gradient(to right, transparent, #000 38%, #000 78%, transparent),
        linear-gradient(to bottom, transparent, #000 16%, #000 84%, transparent);
      mask-composite: intersect;
    }
  }

  .job {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  .left {
    position: relative;
    padding: 0 0 clamp(28px, 4vw, 44px) 32px;
  }

  /* Línea de tiempo vertical que une los nodos */
  .left::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 14px;
    bottom: -8px;
    width: 1px;
    background: var(--line);
  }

  .job:last-child .left::before {
    background: linear-gradient(var(--line), transparent);
  }

  .node {
    position: absolute;
    left: 0;
    top: 6px;
    width: 15px;
    height: 15px;
    border-radius: 50%;
    background: var(--base);
    border: 2px solid var(--muted);
  }

  .current .node {
    background: var(--lime);
    border-color: var(--lime);
    box-shadow: 0 0 0 5px var(--lime-soft);
    animation: pulse 2.4s ease-out infinite;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 16px;
  }

  h3 {
    font-size: 18px;
    line-height: 1.3;
  }

  .meta {
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }

  .role {
    margin-top: 2px;
    color: var(--lime);
    font-size: 14px;
    font-weight: 600;
  }

  .items {
    display: grid;
    gap: 6px;
    margin-top: 10px;
    font-size: 14px;
    color: var(--muted);
  }

  .items li {
    position: relative;
    padding-left: 16px;
    line-height: 1.5;
  }

  .items li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 1px;
    background: var(--lime);
  }

  /* ---- Camino tipo mapa ---- */
  .map {
    display: none;
  }

  @media (min-width: 760px) {
    .job {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      column-gap: clamp(24px, 5vw, 72px);
    }

    .map {
      position: relative;
      display: block;
    }

    .map svg {
      position: absolute;
      left: 0;
      top: 14px;
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    .map path {
      fill: none;
      stroke-linecap: round;
      vector-effect: non-scaling-stroke;
    }

    .map .body {
      stroke-width: 18;
      stroke-opacity: 0.16;
    }

    .map .dash {
      stroke-width: 2.5;
      stroke-dasharray: 1 9;
    }


    .pin {
      position: absolute;
      top: 14px;
      width: 0;
      height: 0;
    }

    .pin i {
      position: absolute;
      left: -7px;
      top: -7px;
      width: 14px;
      height: 14px;
      border-radius: 50%;
      background: var(--fg);
      box-shadow: 0 0 0 5px rgba(243, 245, 238, 0.14);
    }

    .pin b {
      position: absolute;
      left: 16px;
      top: -11px;
      padding: 3px 10px;
      border: 1px solid var(--line);
      border-radius: var(--radius-pill);
      background: rgba(18, 20, 17, 0.7);
      font-size: 12px;
      font-weight: 600;
      line-height: 1.4;
      white-space: nowrap;
      color: var(--muted);
    }

    .pin.flip b {
      left: auto;
      right: 16px;
    }

    .pin.current i {
      background: var(--lime);
      box-shadow: 0 0 0 5px var(--lime-soft);
      animation: pulse 2.4s ease-out infinite;
    }

    .pin.current b {
      color: var(--lime-ink);
      background: var(--lime);
      border-color: var(--lime);
    }
  }

  /* Pulso en expansión: "aquí estoy ahora" */
  @keyframes pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(198, 244, 50, 0.45);
    }
    100% {
      box-shadow: 0 0 0 16px rgba(198, 244, 50, 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .current .node,
    .pin.current i {
      animation: none;
    }
  }
</style>
