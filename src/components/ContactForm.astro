---
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT ?? '';
const email = 'adriel.designstudio@gmail.com';
const services = ['UI/UX', 'Branding', 'QA Testing', 'Graphic Design', 'Social Media'];
---

<form class="form" method="post" action={endpoint || undefined} novalidate data-form data-endpoint={endpoint} data-mail={email}>
  <div class="head">
    <h3>Envíame un mensaje</h3>
    <p class="muted">Cuéntame qué tienes en mente y te respondo a tu correo.</p>
  </div>

  <div class="pair">
    <div class="field">
      <label for="cf-name">Nombre</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" placeholder="Tu nombre" required minlength="2" maxlength="80" />
      <p class="err" id="cf-name-err" data-err="name"></p>
    </div>

    <div class="field">
      <label for="cf-email">Correo</label>
      <input id="cf-email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="tu@correo.com" required />
      <p class="err" id="cf-email-err" data-err="email"></p>
    </div>
  </div>

  <fieldset class="field services">
    <legend>¿En qué te ayudo? <span class="opt">Opcional</span></legend>
    <div class="chips">
      {
        services.map((s, i) => (
          <label class="chip">
            <input type="radio" name="service" value={s} id={`cf-s-${i}`} />
            <span>{s}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="field">
    <label for="cf-msg">Mensaje</label>
    <div class="area">
      <textarea
        id="cf-msg"
        name="message"
        rows="5"
        placeholder="Tu proyecto, plazos o lo que necesites"
        required
        minlength="10"
        maxlength="500"></textarea>
      <span class="count" data-count aria-hidden="true">0/500</span>
    </div>
    <p class="err" id="cf-msg-err" data-err="message"></p>
  </div>

  <div class="hp" aria-hidden="true">
    <label for="cf-web">Sitio web</label>
    <input id="cf-web" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="actions">
    <button class="btn btn--lime submit" type="submit" data-submit>
      <span data-label>Enviar mensaje</span>
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </button>
  </div>

  <div class="status" role="status" aria-live="polite" data-status></div>
</form>

<style>
  .form {
    display: grid;
    gap: 20px;
  }

  .head {
    display: grid;
    gap: 6px;
    padding-bottom: 4px;
  }

  h3 {
    font-size: var(--fs-project);
    text-transform: uppercase;
  }

  .head p {
    font-size: 14px;
  }

  .pair {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 20px;
  }

  .field {
    display: grid;
    align-content: start;
    gap: 8px;
    min-width: 0;
  }

  label,
  legend {
    font-size: 13px;
    font-weight: 700;
  }

  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
  }

  legend {
    padding: 0;
    margin-bottom: 8px;
  }

  .opt {
    margin-left: 6px;
    font-weight: 500;
    color: var(--muted);
  }

  input[type='text'],
  input[type='email'],
  textarea {
    width: 100%;
    min-height: 50px;
    padding: 13px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface-2);
    color: var(--fg);
    font-size: 16px;
    transition:
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease);
  }

  ::placeholder {
    color: color-mix(in srgb, var(--muted) 70%, transparent);
  }

  input[type='text']:hover,
  input[type='email']:hover,
  textarea:hover {
    border-color: color-mix(in srgb, var(--fg) 28%, transparent);
  }

  input[type='text']:focus-visible,
  input[type='email']:focus-visible,
  textarea:focus-visible {
    outline: none;
    border-color: var(--lime);
    box-shadow: 0 0 0 3px var(--lime-soft);
  }

  input[aria-invalid='true'],
  textarea[aria-invalid='true'] {
    border-color: #ff8a7a;
  }

  .area {
    position: relative;
  }

  textarea {
    display: block;
    resize: vertical;
    min-height: 150px;
    padding-bottom: 34px;
  }

  .count {
    position: absolute;
    right: 14px;
    bottom: 10px;
    font-size: 12px;
    color: var(--muted);
    pointer-events: none;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    position: relative;
    cursor: pointer;
  }

  .chip input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .chip span {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 0 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-pill);
    font-size: 14px;
    font-weight: 500;
    transition:
      border-color 0.2s var(--ease),
      background-color 0.2s var(--ease),
      color 0.2s var(--ease);
  }

  .chip:hover span {
    border-color: var(--lime);
  }

  .chip input:checked + span {
    background: var(--lime);
    border-color: var(--lime);
    color: var(--lime-ink);
  }

  .chip input:focus-visible + span {
    outline: 2px solid var(--lime);
    outline-offset: 2px;
  }

  .err {
    font-size: 13px;
    font-weight: 600;
    color: #ff8a7a;
  }

  .err:empty {
    display: none;
  }

  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .actions {
    display: flex;
    align-items: center;
    padding-top: 4px;
  }

  .submit {
    min-width: 200px;
    border: 0;
    font-weight: 700;
  }

  .submit svg {
    transition: transform 0.2s var(--ease);
  }

  .submit:hover svg {
    transform: translateX(3px);
  }

  .submit:disabled {
    opacity: 0.6;
    cursor: wait;
  }

  .status:empty {
    display: none;
  }

  .status :global(.ok) {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 16px;
    border: 1px solid var(--lime);
    border-radius: 12px;
    background: var(--lime-soft);
    font-size: 14px;
  }

  .status :global(.ok svg) {
    flex: none;
    width: 20px;
    height: 20px;
    margin-top: 1px;
    stroke: var(--lime);
  }

  .status :global(.ok a) {
    color: var(--lime);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .status :global(.bad) {
    padding: 14px 16px;
    border: 1px solid #ff8a7a;
    border-radius: 12px;
    font-size: 14px;
  }

  @media (min-width: 640px) {
    .pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 479px) {
    .submit {
      flex: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .submit svg,
    input,
    textarea,
    .chip span {
      transition: none;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]');

  if (form) {
    const endpoint = form.dataset.endpoint ?? '';
    const mail = form.dataset.mail ?? '';
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    const label = form.querySelector<HTMLElement>('[data-label]')!;
    const counter = form.querySelector<HTMLElement>('[data-count]')!;
    const name = form.elements.namedItem('name') as HTMLInputElement;
    const email = form.elements.namedItem('email') as HTMLInputElement;
    const message = form.elements.namedItem('message') as HTMLTextAreaElement;
    const honeypot = form.elements.namedItem('website') as HTMLInputElement;

    const showError = (field: HTMLInputElement | HTMLTextAreaElement, msg: string) => {
      const out = form.querySelector<HTMLElement>(`[data-err="${field.name}"]`)!;
      out.textContent = msg;
      if (msg) {
        field.setAttribute('aria-invalid', 'true');
        field.setAttribute('aria-describedby', out.id);
      } else {
        field.removeAttribute('aria-invalid');
        field.removeAttribute('aria-describedby');
      }
      return !msg;
    };

    const validators: Array<[HTMLInputElement | HTMLTextAreaElement, () => string]> = [
      [
        name,
        () => {
          const n = name.value.trim().length;
          if (n === 0) return 'Escribe tu nombre.';
          if (n < 2) return 'Tu nombre debe tener al menos 2 caracteres.';
          return '';
        },
      ],
      [
        email,
        () =>
          /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email.value.trim()) ? '' : 'Escribe un correo válido.',
      ],
      [
        message,
        () => {
          const n = message.value.trim().length;
          if (n === 0) return 'Cuéntame en qué te puedo ayudar.';
          if (n < 10) return 'Escribe al menos 10 caracteres para entender tu idea.';
          return '';
        },
      ],
    ];

    const check = '<svg viewBox="0 0 24 24" fill="none" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7.5"/></svg>';

    const showOk = (text: string, withMail = false) => {
      const box = document.createElement('div');
      box.className = 'ok';
      box.innerHTML = check;
      const p = document.createElement('p');
      p.textContent = text;
      if (withMail) {
        p.append(' Si no se abrió, escríbeme a ');
        const a = document.createElement('a');
        a.href = `mailto:${mail}`;
        a.textContent = mail;
        p.append(a, '.');
      }
      box.append(p);
      status.replaceChildren(box);
    };

    const showBad = (text: string) => {
      const box = document.createElement('p');
      box.className = 'bad';
      box.textContent = text;
      status.replaceChildren(box);
    };

    message.addEventListener('input', () => {
      counter.textContent = `${message.value.length}/500`;
    });

    validators.forEach(([field, fn]) => {
      field.addEventListener('blur', () => {
        if (field.value) showError(field, fn());
      });
      field.addEventListener('input', () => {
        if (field.getAttribute('aria-invalid')) showError(field, fn());
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (honeypot.value) return;

      let firstBad: HTMLElement | null = null;
      validators.forEach(([field, fn]) => {
        if (!showError(field, fn()) && !firstBad) firstBad = field;
      });
      if (firstBad) {
        (firstBad as HTMLElement).focus();
        return;
      }

      const service = (form.elements.namedItem('service') as RadioNodeList).value;

      // Sin servicio de formularios configurado: abre el correo del visitante con el mensaje listo.
      if (!endpoint) {
        const subject = `${service ? `Proyecto de ${service}` : 'Contacto desde el portafolio'} · ${name.value.trim()}`;
        const body = `${message.value.trim()}\n\n${name.value.trim()}\n${email.value.trim()}`;
        window.location.href = `mailto:${mail}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        showOk('Abrí tu app de correo con el mensaje listo para enviar.', true);
        return;
      }

      submit.disabled = true;
      label.textContent = 'Enviando…';
      status.replaceChildren();

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { Accept: 'application/json' },
          body: new FormData(form),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        counter.textContent = '0/500';
        showOk('Gracias, recibí tu mensaje. Te respondo pronto a tu correo.');
      } catch {
        showBad(`No se pudo enviar. Inténtalo de nuevo o escríbeme a ${mail}.`);
      } finally {
        submit.disabled = false;
        label.textContent = 'Enviar mensaje';
      }
    });
  }
</script>
