---
import { Image } from 'astro:assets';
import avatar from '../assets/hero/avatar-adriel.png';
---

<div class="hero-image">
  <span class="shadow" aria-hidden="true"></span>
  <div class="float">
    <Image
      src={avatar}
      alt="Avatar de Adriel sonriendo con el pulgar arriba"
      widths={[480, 768, 1024]}
      sizes="(min-width: 1024px) 560px, (min-width: 760px) 70vw, 80vw"
      format="webp"
      quality={85}
      loading="eager"
      fetchpriority="high"
    />
  </div>
</div>

<style>
  .hero-image {
    position: relative;
    width: 80%;
    max-width: 380px;
    margin-inline: auto;
  }

  .float {
    animation: float 7s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    will-change: transform;
  }

  .float :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1217 / 1293;
    user-select: none;
    filter: drop-shadow(0 18px 28px rgba(0, 0, 0, 0.35));
  }

  .shadow {
    position: absolute;
    left: 20%;
    right: 20%;
    bottom: -4%;
    height: 8%;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.45);
    filter: blur(14px);
    animation: shadow 7s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  @keyframes float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-20px);
    }
  }

  @keyframes shadow {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.9;
    }
    50% {
      transform: scale(0.82);
      opacity: 0.5;
    }
  }

  @media (min-width: 760px) and (max-width: 1023px) {
    .hero-image {
      width: 70vw;
      max-width: 480px;
    }
  }

  @media (min-width: 1024px) {
    .hero-image {
      width: 100%;
      max-width: 600px;
      margin-left: auto;
      margin-right: -6%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .float,
    .shadow {
      animation: none;
    }
  }
</style>
