---
// Espacio reservado. Imagen futura: src/assets/hero/hero-composicion.png
// con <Picture /> (WebP y AVIF, anchos 480, 768 y 1024, loading="eager").
// [PENDIENTE: elegir proyecto para el hero]
---

<div class="hero-image" role="img" aria-label="Espacio reservado para la imagen del hero">
  <p class="title">Espacio para imagen del hero</p>
  <p class="note">Reemplazar por la composición final del hero</p>
</div>

<style>
  .hero-image {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 8px;
    width: 100%;
    max-width: 620px;
    aspect-ratio: 1 / 1;
    margin-inline: auto;
    padding: 24px;
    text-align: center;
    background: var(--surface);
    border: 2px dashed var(--lime);
    border-radius: var(--radius-card);
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(22px, 3vw, 32px);
    text-transform: uppercase;
    text-wrap: balance;
  }

  .note {
    font-size: 14px;
    color: var(--muted);
    text-wrap: balance;
  }

  @media (max-width: 759px) {
    .hero-image {
      aspect-ratio: 4 / 3;
    }
  }

  @media (min-width: 760px) and (max-width: 1023px) {
    .hero-image {
      width: 70vw;
    }
  }

  @media (min-width: 1024px) {
    .hero-image {
      max-width: 560px;
      margin-inline: 0 auto;
    }
  }
</style>
