<div class="smoke" aria-hidden="true">
  <div class="px" data-px>
    <span class="blob b1"></span>
    <span class="blob b2"></span>
    <span class="blob b3"></span>
    <span class="blob b4"></span>
  </div>
  <div class="vignette"></div>
</div>

<style>
  .smoke {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: var(--base);
    pointer-events: none;
  }

  .px {
    position: absolute;
    inset: 0;
    --px: 0;
    --py: 0;
    transform: translate3d(calc(var(--px) * 36px), calc(var(--py) * 28px), 0);
  }

  .blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    will-change: transform;
    animation:
      drift var(--dur) ease-in-out infinite,
      morph 18s ease-in-out infinite;
  }

  .b1 {
    --dur: 26s;
    width: 52vmax;
    height: 52vmax;
    left: -12vmax;
    top: -12vmax;
    opacity: 0.14;
    background: radial-gradient(circle, var(--lime) 0%, transparent 68%);
  }
  .b2 {
    --dur: 32s;
    width: 60vmax;
    height: 60vmax;
    left: -15vmax;
    bottom: -18vmax;
    opacity: 0.08;
    background: radial-gradient(circle, var(--lime) 0%, transparent 70%);
  }
  .b3 {
    --dur: 24s;
    width: 50vmax;
    height: 50vmax;
    right: -10vmax;
    top: -8vmax;
    opacity: 0.6;
    background: radial-gradient(circle, var(--case-tint) 0%, transparent 68%);
  }
  .b4 {
    --dur: 20s;
    width: 34vmax;
    height: 34vmax;
    right: -6vmax;
    bottom: -8vmax;
    opacity: 0.1;
    background: radial-gradient(circle, var(--lime) 0%, transparent 70%);
  }

  .vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse 60% 55% at 50% 50%,
      rgba(18, 20, 17, 0.8),
      rgba(18, 20, 17, 0.4) 60%,
      transparent
    );
  }

  @keyframes drift {
    0%,
    100% {
      transform: translate(0, 0) scale(1) rotate(0);
    }
    35% {
      transform: translate(5vw, -4vh) scale(1.12) rotate(18deg);
    }
    70% {
      transform: translate(-4vw, 5vh) scale(0.92) rotate(-14deg);
    }
  }

  @keyframes morph {
    0%,
    100% {
      border-radius: 50% 50% 50% 50% / 50% 50% 50% 50%;
    }
    50% {
      border-radius: 62% 38% 46% 54% / 44% 58% 42% 56%;
    }
  }

  @media (max-width: 479px) {
    .b2,
    .b4 {
      display: none;
    }
  }

  @media (pointer: coarse) {
    .px {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .px {
      transform: none;
    }
    .blob {
      animation: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-px]');
  const canMove =
    root &&
    !matchMedia('(pointer: coarse)').matches &&
    !matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (root && canMove) {
    let tx = 0;
    let ty = 0;
    let x = 0;
    let y = 0;
    let running = false;

    const tick = () => {
      x += (tx - x) * 0.05;
      y += (ty - y) * 0.05;
      root.style.setProperty('--px', x.toFixed(4));
      root.style.setProperty('--py', y.toFixed(4));
      if (Math.abs(tx - x) > 0.001 || Math.abs(ty - y) > 0.001) {
        requestAnimationFrame(tick);
      } else {
        running = false;
      }
    };

    addEventListener(
      'pointermove',
      (e) => {
        tx = (e.clientX / innerWidth) * 2 - 1;
        ty = (e.clientY / innerHeight) * 2 - 1;
        if (!running) {
          running = true;
          requestAnimationFrame(tick);
        }
      },
      { passive: true },
    );
  }
</script>
