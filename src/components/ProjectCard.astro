---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { brandShades } from '../lib/color';

interface Props {
  id: string;
  project: CollectionEntry<'projects'>['data'];
}

const { id, project: p } = Astro.props;
const shades = p.brand ? brandShades(p.brand) : undefined;
const meta = [p.client, p.year].filter(Boolean).join(' · ');
---

<li class="pcard card" data-category={p.category} data-project={id}>
  <div class:list={['cover', { branded: Boolean(p.brand && p.cover) }]} style={`--accent:${p.accent};--brand:${p.brand ?? p.accent};--brand-deep:${shades?.deep ?? p.accent};--brand-soft:${shades?.soft ?? p.accent}`}>
    {
      p.cover ? (
        <div class="art">
          <Image src={p.cover} alt={`Portada del proyecto ${p.title}`} widths={[400, 640, 800]} sizes="(min-width:1024px) 380px, (min-width:760px) 45vw, 92vw" loading="lazy" />
        </div>
      ) : (
        <span class="ph">{p.title}</span>
      )
    }
    {
      p.icon && (
        <span class="app-icon">
          <Image src={p.icon} alt={`Isotipo de la app ${p.title}`} width={58} height={58} densities={[1, 2]} format="webp" loading="lazy" />
        </span>
      )
    }
    <span class="strip" aria-hidden="true"></span>
  </div>
  <div class="body">
    <p class="cat">{p.category}</p>
    <p class="meta">{meta}</p>
    <h3>
      <button type="button" class="open" data-open={id} aria-haspopup="dialog">{p.title}</button>
    </h3>
    <p class="hook">{p.hook}</p>
  </div>
</li>

<style>
  .pcard {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    transition: background-color 0.2s, transform 0.25s var(--ease);
  }

  @media (hover: hover) {
    .pcard:hover {
      background: var(--surface-2);
      transform: translateY(-4px);
    }
    .pcard:has(.branded):hover {
      box-shadow: 0 22px 40px -24px var(--brand);
    }
    .pcard:hover .cover.branded {
      background-position: 50% 100%;
    }
    .pcard:hover .art {
      transform: scale(1.07);
    }
    .pcard:hover .app-icon {
      transform: translateY(-3px) rotate(-5deg) scale(1.1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .art :global(img) {
      animation: none;
    }
  }

  .cover {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--surface-2);
    overflow: hidden;
  }

  /* Fondo con el color principal de la app: de un tono más oscuro arriba a uno más claro abajo */
  .cover.branded {
    background: linear-gradient(180deg, var(--brand-deep) 0%, var(--brand) 62%, var(--brand-soft) 100%);
    background-size: 100% 150%;
    background-position: 50% 0%;
    transition: background-position 0.9s var(--ease);
  }

  .art {
    position: absolute;
    inset: 0;
    transition: transform 0.6s var(--ease);
  }

  .art :global(img) {
    animation: bob 7s cubic-bezier(0.45, 0, 0.55, 1) infinite alternate;
    will-change: transform;
  }

  .pcard:nth-child(3n + 2) .art :global(img) {
    animation-duration: 8.5s;
    animation-delay: -2.5s;
  }
  .pcard:nth-child(3n) .art :global(img) {
    animation-duration: 6.2s;
    animation-delay: -4.5s;
  }

  @keyframes bob {
    from {
      transform: translateY(5px);
    }
    to {
      transform: translateY(-7px);
    }
  }

  .cover :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pcard {
    transition: background-color 0.2s, transform 0.3s var(--ease), box-shadow 0.4s;
  }

  .ph {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding: 24px 24px 30px;
    text-align: center;
    font-family: var(--font-display);
    font-size: var(--fs-project);
    line-height: 1.05;
    text-transform: uppercase;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .strip {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 6px;
    background: var(--accent);
  }

  /* Isotipo de la app: indica que es un producto real */
  .app-icon {
    position: absolute;
    left: 16px;
    bottom: 22px;
    z-index: 1;
    width: 58px;
    height: 58px;
    overflow: hidden;
    border-radius: 16px;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.22),
      0 10px 18px -5px rgba(0, 0, 0, 0.58);
    transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .app-icon :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .body {
    display: grid;
    align-content: start;
    gap: 4px;
    padding: clamp(16px, 2vw, 24px);
  }

  .cat {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lime);
  }

  .meta {
    font-size: 13px;
    color: var(--muted);
  }

  h3 {
    margin-top: 6px;
    font-size: var(--fs-project);
    text-transform: uppercase;
  }

  .open {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-transform: inherit;
    text-align: left;
    color: inherit;
  }

  .open::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-card);
  }

  .open:focus-visible {
    outline: none;
  }
  .open:focus-visible::after {
    outline: 2px solid var(--lime);
    outline-offset: -2px;
  }

  .hook {
    margin-top: 4px;
    font-size: 14px;
    color: var(--muted);
  }
</style>
