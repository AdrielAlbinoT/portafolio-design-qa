---
const services = [
  { t: 'UI/UX Design', d: 'Interfaces para apps móviles y web, desde aplicaciones funcionales hasta landing pages.' },
  { t: 'QA testing', d: 'Pruebas funcionales, de regresión y de usabilidad en web, Android e iOS.' },
  { t: 'Editorial', d: 'Brochures, manuales, revistas y material editorial.' },
  { t: 'Branding', d: 'Logotipos e identidades de marca completas.' },
  { t: 'Digital Design', d: 'Flyers, banners, gráficos digitales y material para impresión.' },
  { t: 'Social Media', d: 'Contenido gráfico para Instagram, YouTube, TikTok y otras plataformas.' },
];
---

<section class="section" id="servicios" aria-labelledby="services-title">
  <div class="container">
    <div class="section-head">
      <p class="label">Servicios</p>
      <h2 class="h-section" id="services-title">Qué hago</h2>
    </div>
    <ul class="grid">
      {
        services.map((s, i) => (
          <li class:list={['card item', { first: i === 0 }]}>
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--gap);
  }

  .item {
    display: grid;
    align-content: start;
    gap: 12px;
    padding: clamp(20px, 2.5vw, 32px);
    transition: background-color 0.2s, transform 0.25s var(--ease);
  }

  .first {
    border-color: var(--lime);
  }

  .num {
    font-family: var(--font-display);
    font-size: 28px;
    line-height: 1;
    color: var(--lime);
  }

  h3 {
    font-size: var(--fs-project);
    text-transform: uppercase;
  }

  p {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
  }

  @media (hover: hover) {
    .item:hover {
      background: var(--surface-2);
      transform: translateY(-3px);
    }
  }

  @media (min-width: 760px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
